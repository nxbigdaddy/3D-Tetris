    "test": "node --test \"tests/**/*.test.js\"",
    "play": "node scripts/play-headless.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.3"
  }
