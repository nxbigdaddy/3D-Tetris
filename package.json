{
  "name": "blockout-3d-tetris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "三维俄罗斯方块(Blockout 式):5×5×12 方井 + 四立方体三轴旋转 + 整层消除。规则内核与渲染引擎无关。",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "build": "vite build",
